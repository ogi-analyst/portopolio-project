
-- SELECT #untuk mengambil data 


--  mengambil semua data di tabel employee_Salary
SELECT *
FROM employee_salary;

--   mengambil semua data di tabel employee_Salary dan memfilter salary di atas 50.000
SELECT *
FROM employee_salary
WHERE salary >= 50000;

-- CTEs
WITH CTE_Example AS
(
SELECT gender,AVG(age),MAX(age),MIN(age),COUNT(age)
FROM employee_demographics
GROUP BY gender
)
SELECT AVG(`MAX(age)`)
FROM CTE_Example
;


-- subquery
SELECT AVG(`MAX(age)`)
FROM (
SELECT gender,AVG(age),MAX(age),MIN(age),COUNT(age)
FROM employee_demographics
GROUP BY gender
) AS Agg_table;


-- CASE
SELECT *,
CASE 
	WHEN age < 30 THEN 'Young'
    WHEN age > 30 THEN 'Old'
END as keterangan
FROM employee_demographics;


-- WINDOW FUNCTION
SELECT dem.first_name,dem.last_name,gender,salary,
ROW_NUMBER() OVER(PARTITION BY gender ORDER BY salary) AS row_num,
RANK() OVER(PARTITION BY gender ORDER BY salary) AS rank_num,
DENSE_RANK() OVER(PARTITION BY gender ORDER BY salary) AS dense_rank_num
FROM employee_demographics dem
JOIN employee_salary sal
	ON dem.employee_id = sal.employee_id
;


-- temporary table

CREATE TEMPORARY TABLE salary_over_50k
SELECT *
FROM employee_salary
WHERE salary > 50000;

SELECT *
FROM salary_over_50k;


